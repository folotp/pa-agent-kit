#!/usr/bin/env ruby
# Inspect YAML nodes without constructing tagged Ruby objects or evaluating expressions.
# Aliases, custom tags, complex keys and duplicates require an explicit, unambiguous declaration.
require 'psych'

BadYaml = Class.new(StandardError)

def decode(node, uses)
  return nil unless node
  raise BadYaml, 'custom YAML tag' if node.tag
  case node
  when Psych::Nodes::Scalar
    node.value
  when Psych::Nodes::Sequence
    node.children.map { |item| decode(item, uses) }
  when Psych::Nodes::Mapping
    node.children.each_slice(2).each_with_object({}) do |(key, value), fields|
      raise BadYaml, 'complex mapping key' unless key.is_a?(Psych::Nodes::Scalar) && !key.tag
      name = key.value
      raise BadYaml, "ambiguous key #{name}" if name == '<<' || fields.key?(name)
      fields[name] = decode(value, uses)
      uses << [key.start_line + 1, fields[name]] if name == 'uses'
    end
  else
    raise BadYaml, 'YAML alias'
  end
end

def pinned?(value)
  return false unless value.is_a?(String) && value !~ /\s/
  return true if value.start_with?('./') && value.length > 2
  return !!(value =~ /\Adocker:\/\/[^@]+@sha256:[0-9a-f]{64}\z/) if value.start_with?('docker://')
  !!(value =~ /\A[^@]+@[0-9a-f]{40}\z/)
end

def ci_step?(workflow)
  return false unless workflow.is_a?(Hash) && workflow['jobs'].is_a?(Hash)
  workflow['jobs'].values.any? do |job|
    next false unless job.is_a?(Hash) && !job.key?('if') && job['steps'].is_a?(Array)
    job['steps'].any? do |step|
      step.is_a?(Hash) && !step.key?('if') && !step.key?('uses') &&
        !step.key?('working-directory') && !step.key?('shell') &&
        !job.dig('defaults', 'run') && !workflow.dig('defaults', 'run') &&
        step['run'].is_a?(String) && step['run'].strip == './dev ci'
    end
  end
end

mode = ARGV.shift
files = Dir.glob('.github/workflows/*.{yml,yaml}')
files += Dir.glob('.github/actions/**/action.{yml,yaml}') unless mode == '--ci-step'
files = ARGV if mode == '--remote'
failed = false
found = false
files.sort.each do |path|
  begin
    raise BadYaml, 'symbolic link' if File.symlink?(path)
    stream = Psych.parse_stream(File.read(path))
    raise BadYaml, 'multiple documents' if stream.children.size > 1
    uses = []
    document = decode(stream.children.first&.root, uses)
    if mode == '--ci-step'
      found ||= ci_step?(document)
    elsif mode == '--remote'
      found ||= uses.any? { |_, value| !value.is_a?(String) || !value.start_with?('./', 'docker://') }
    else
      uses.each do |line, value|
        next if pinned?(value)
        puts "#{path}:#{line}: #{value} is not pinned: use the full commit SHA with a # vX.Y.Z comment"
        failed = true
      end
    end
  rescue Psych::SyntaxError, BadYaml, SystemCallError, TypeError => error
    puts "#{path}: #{error.message}; use explicit YAML keys and scalar action references" unless mode == '--ci-step'
    failed = true
  end
end
if mode == '--remote'
  exit 2 if failed
  puts(found ? 'remote' : 'local')
elsif mode == '--ci-step'
  exit(found ? 0 : 1)
end
exit(failed ? 1 : 0)
