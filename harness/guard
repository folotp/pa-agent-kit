#!/usr/bin/env bash
# guard: the pre-tool-use hook of the harness core, one script for the three agents.
#
# Usage, from a binding:  harness/guard claude|codex|antigravity   (the hook payload on stdin)
# Bindings: harness/bindings/ (templates) and the repository's .claude/settings.json,
# .codex/hooks.json and .agents/hooks.json. Contract: docs/harness-core.md, 'Guard'.
#
# It reads one shell command an agent is about to run and denies:
#   - always: a push to main or master, a push of every branch or of a wildcard refspec, a force
#     push, a remote branch deletion, a git hook skipped (--no-verify, commit -n, -c
#     core.hooksPath=), a git alias defined on the command line, a PR merged, marked ready or set
#     to auto-merge (PA's actions), a release created or edited other than as a draft, a local
#     branch deleted by force (`git branch -D`, `-d -f`, `--delete --force`: nothing checked that
#     it was merged; the core's prune script deletes only what GitHub shows merged);
#   - where nobody answers a prompt (a Claude Code cloud session, a permission mode that does not
#     ask, or a mode the hook cannot see): the release verbs, `./dev apply` and `./dev deploy`.
# Each denial names the sanctioned way instead (24i's refusal rule): a `/dev-` command or the exact
# command to run, so that an agent never has to guess and never retries the refusal another way.
# Anything else passes. Patterns are matched on the command text after shell quoting is removed,
# so a commit message quoting a denied command is denied too: reword it. Variables, aliases and
# functions defined elsewhere, and interpreters (python -c, …), are not seen.
#
# Early warning, not the boundary: an agent with a shell can edit this file or its bindings. The
# boundary is the credentials PA releases (report 2.3). It fails closed: no jq, a payload it
# cannot read (a command that is not a string included), a command too long to judge in time or
# an unknown agent denies the call. Uses bash 3.2 builtins and jq only (macOS /bin/bash), and
# writes no temporary file.
set -uo pipefail
LC_ALL=C

agent="${1:-}"

# The core directory this guard runs from (`.harness` in a consumer, `harness` in the workshop):
# messages name the token script by the path the agent can run.
core="$(basename "$(dirname "$0")")"
case "$core" in harness | .harness) ;; *) core=.harness ;; esac

# Claude Code and Codex deny on exit 2 with the reason on stderr; Antigravity reads a decision on
# stdout. Reasons hold no double quote or backslash, so they need no JSON escaping.
deny() {
  if [ "$agent" = antigravity ]; then
    printf '{"decision":"deny","reason":"harness guard: %s"}\n' "$1"
    exit 0
  fi
  printf 'blocked by the harness guard: %s\n' "$1" >&2
  exit 2
}

IFS= read -r -d '' payload || true
command -v jq >/dev/null 2>&1 || deny "jq is missing, so the guard cannot read the call: install jq (\`./dev setup\` checks the tools), then retry"

case "$agent" in
  claude | codex)
    tool="$(printf '%s' "$payload" | jq -er '.tool_name | strings' 2>/dev/null)" || deny "cannot read the hook payload: run \`./dev setup\` (it checks the guard and its tools), then retry"
    cmd_path='.tool_input.command'
    mode="$(printf '%s' "$payload" | jq -r '.permission_mode // "" | strings' 2>/dev/null)" || deny "cannot read the hook payload: run \`./dev setup\` (it checks the guard and its tools), then retry"
    ;;
  antigravity)
    tool="$(printf '%s' "$payload" | jq -er '.toolCall.name | strings' 2>/dev/null)" || deny "cannot read the hook payload: run \`./dev setup\` (it checks the guard and its tools), then retry"
    cmd_path='.toolCall.args.CommandLine'
    mode=""
    ;;
  *) deny "unknown agent '$agent' (claude, codex or antigravity): the hook binding is wrong; \`./dev check\` names the entry to merge from $core/bindings/" ;;
esac

# Only shell commands are judged. apply_patch (Codex) carries a patch in .tool_input.command.
case "$tool" in Bash | shell | exec_command | local_shell | run_command) ;; *) exit 0 ;; esac

# A judged command that is present but not a string (an array, a number, an object) denies: the
# agent may still run it, and the guard cannot say what it is.
cmd="$(printf '%s' "$payload" | jq -r "$cmd_path"' | if . == null then "" elif type == "string" then . else error("not a string") end' 2>/dev/null)" ||
  deny "cannot read the hook payload: the command is not a string; send it as one command string, or tell PA if the client cannot (\`./dev check\` checks the hook bindings)"
[ -n "$cmd" ] || exit 0

# A hook that runs past its timeout lets the call through in the agents, so a command too long to
# judge quickly denies instead (session 24b: about 0.3 s per 50 KB here; the bindings allow 10 s).
[ "${#cmd}" -le 200000 ] || deny "the command is too long for the guard to judge in time: split it, or put its payload in a file (\`git commit -F <file>\`, \`gh pr create --body-file <file>\`)"

# The command is judged in two views; a denial in either denies. jq builds both, one character at
# a time with foreach, which is linear. Measured in session 24b: bash 3.2's ${var//…} is
# quadratic (8 s for 6 KB in a UTF-8 locale) and so are jq's regex functions on a long string
# (gsub, scan, splits: 31 s for 190 KB), either of which runs past the hook timeout.
#
# View 1, flat: a line continued by a trailing backslash is joined, $'…' and $"…" markers, quotes
# and backslashes are dropped, and every ; & | starts a new simple command. `"git" push origin
# 'main'`, `\git push …` and `HEAD:ma""in` read as plain words, and a quoted command
# (`bash -c '…'`) is judged as code.
#
# View 2, quote-aware (Codex C5): only an unquoted ; & | or newline starts a new simple command,
# quotes are dropped, and the blanks inside a quoted or escaped argument become \001, so the
# argument stays one word. A quoted separator then does not cut a command in two
# (`git -C '/tmp/a;b' push origin HEAD:main`), and text inside an argument is not an option
# (`--notes 'use --draft'` is no draft flag). Escapes are not decoded: `$'\x6d'` stays as written.
#
# Only the simple commands that could match a rule are passed on (they name git, gh, dev, gate or
# a PullRequest mutation); a final \002 line proves that jq ran to the end. Characters are code
# points: 9-13 and 32 blanks, 10 newline, 34 ", 36 $, 39 single quote, 59 ;, 38 &, 92 \, 124 |.
# shellcheck disable=SC2016 # jq program, not shell
views='
def blank: . == 32 or . == 9 or . == 10 or . == 11 or . == 12 or . == 13;
def flat:
  [foreach (explode[], null) as $c ({bs: false, dol: false, emit: []};
     if $c == null then .emit = (if .dol then [36] else [] end)
     elif .bs and $c == 10 then .bs = false | .dol = false | .emit = []
     else
       (if .dol and $c != 39 and $c != 34 then [36] else [] end) as $pre
       | .bs = ($c == 92)
       | .dol = ($c == 36)
       | .emit = $pre + (if $c == 36 or $c == 34 or $c == 39 or $c == 92 then []
                         elif $c == 59 or $c == 38 or $c == 124 then [10]
                         else [$c] end)
     end;
     .emit[])] | implode;
def quoted:
  [foreach (explode[], null) as $c ({q: "", esc: false, dol: false, emit: []};
     if $c == null then .emit = (if .dol then [36] else [] end)
     elif .esc then .esc = false | .emit = (if $c == 10 then [] elif ($c | blank) then [1] else [$c] end)
     elif .dol and $c == 39 then .dol = false | .q = "a" | .emit = []
     elif .dol and $c == 34 then .dol = false | .q = "d" | .emit = []
     else
       (if .dol then [36] else [] end) as $pre
       | .dol = false
       | if .q == "" then
           if $c == 92 then .esc = true | .emit = $pre
           elif $c == 39 then .q = "s" | .emit = $pre
           elif $c == 34 then .q = "d" | .emit = $pre
           elif $c == 36 then .dol = true | .emit = $pre
           elif $c == 59 or $c == 38 or $c == 124 or $c == 10 then .emit = $pre + [10]
           else .emit = $pre + [$c] end
         elif .q == "s" then
           if $c == 39 then .q = "" | .emit = [] elif ($c | blank) then .emit = [1] else .emit = [$c] end
         else
           if $c == 92 then .esc = true | .emit = []
           elif ($c == 39 and .q == "a") or ($c == 34 and .q == "d") then .q = "" | .emit = []
           elif ($c | blank) then .emit = [1] else .emit = [$c] end
         end
     end;
     .emit[])] | implode;
((flat, quoted) | split("\n")[] | select(test("git|gh|dev|gate|PullRequest"))), ([2] | implode)'

# Where can a prompt be answered? Claude Code documents CLAUDE_CODE_REMOTE=true in cloud
# sessions. Session 12 measured that an `ask` rule did not prompt in bypass mode; dontAsk refuses
# instead of asking. Antigravity's payload carries no mode. An unknown or missing mode counts as
# unattended (fail closed).
unattended=""
if [ "${CLAUDE_CODE_REMOTE:-}" = true ]; then
  unattended="a cloud session"
else
  case "$mode" in
    default | acceptEdits | plan | auto) ;;
    *) unattended="permission mode '${mode:-not given}'" ;;
  esac
fi

sep="(^|[[:space:];&|(\`/])"
end="([[:space:];&|)]|$)"

# The release verbs, through a path, a wrapper or `mise exec`, and the gate's own release entry
# points.
release_re="${sep}dev[[:space:]]+(apply|deploy)${end}"
gate_re="${sep}gate[[:space:]]+(release|--stage2)${end}"
# The GraphQL mutations that merge a PR, mark it ready or set it to merge itself (gh api graphql,
# curl, …).
mutation_re="(mergePullRequest|markPullRequestReadyForReview|enablePullRequestAutoMerge)"
# `gh`, flags, the group, flags, the verb (each flag with at most one value): matches
# `gh pr -R o/r merge 5` and `gh -R o/r pr merge 5` (Codex C4: gh takes inherited flags before the
# group too), not `gh pr create --title ready to merge`.
flags="([[:space:]]+-[^[:space:]]*([[:space:]]+[^-[:space:]][^[:space:]]*)?)*"
gh="${sep}gh${flags}[[:space:]]+"

git_re="${sep}git[[:space:]]"
push_re="${sep}git[[:space:]]+([^[:space:]]+[[:space:]]+)*push${end}"
commit_re="${sep}git[[:space:]]+([^[:space:]]+[[:space:]]+)*commit${end}"
branch_re="${sep}git[[:space:]]+([^[:space:]]+[[:space:]]+)*branch${end}"
# git branch deleting by force: a short-flag cluster holding D (`-D`, `-vD`), or a delete flag and
# a force flag in any order and form (`-df`, `-d -f`, `--delete --force`, `--force -d`; git takes
# a unique prefix of a long option: `--d…` is --delete, `--forc…` --force, `--for` is ambiguous
# with --format). The value of -u is not a cluster; `-m`, `-M`, `-c`, `-C`, `--list` never delete.
branch_D_re="[[:space:]]-[^-[:space:]u=]*D"
branch_delete_re="[[:space:]](-[^-[:space:]u=]*d|--d[a-z]*${end})"
branch_force_re="[[:space:]](-[^-[:space:]u=]*f|--forc[a-z]*${end})"
main_re="[[:space:]:+](refs/heads/)?(main|master)${end}"
# --force, --mirror, --all, --delete, --prune and their abbreviations (git accepts a unique prefix
# of a long option); a short-flag cluster holding f or d before the value-taking -o (`-fu`); a
# +refspec; a :refspec (deletion) or a bare : (every matching branch); a wildcard refspec.
force_re="[[:space:]](--for[a-z-]*(=[^[:space:]]*)?|--mi[a-z]*|--al[a-z]*|--de[a-z]*|--pru[a-z]*)${end}|[[:space:]]-[^-[:space:]o=]*[fd]|[[:space:]]\+[^[:space:]]|[[:space:]]:|[*]"
# commit -n is --no-verify: a short-flag cluster holding n before any value-taking flag.
commit_n_re="[[:space:]]-[^-[:space:]mCcFtuS=]*n"
# -c or --config-env setting an alias (it hides the verb) or core.hooksPath (it skips the hooks);
# matched without case, as git reads the keys.
config_re="[[:space:]](-c[[:space:]]*|--config-env[[:space:]=]+)(alias\.|core\.hookspath)"
merge_re="${gh}pr${flags}[[:space:]]+(merge|ready)${end}|${gh}api[[:space:]].*pulls/[0-9]+/merge${end}"
release_create_re="${gh}release${flags}[[:space:]]+(create|new)${end}"
release_edit_re="${gh}release${flags}[[:space:]]+edit${end}"
api_release_re="${gh}api[[:space:]].*releases"
# Draft flags as gh parses booleans (true: 1 t T true TRUE True; false: 0 f F false FALSE False).
draft_re="[[:space:]](--draft(=([tT]([rR][uU][eE])?|1))?|-d)${end}"
undraft_re="draft=([fF]([aA][lL][sS][eE])?|0)${end}"
# gh api writes with -X/--method POST|PATCH|PUT, or by default as soon as it sends a field.
api_write_re="[[:space:]](-X|--method)[[:space:]=]*([pP][oO][sS][tT]|[pP][aA][tT][cC][hH]|[pP][uU][tT])|[[:space:]](-f|-F|--field|--raw-field|--input)([[:space:]=]|$)"

# Only relax the release API text match when the entire request consists of standalone
# cat writes with literal input. Parse from the first line so a header inside a quoted
# argument, nested shell, or another heredoc cannot start a trusted data region.
literal_file_writes() {
  local line delimiter="" seen="" path="[a-zA-Z0-9_./-]+" gap="[[:blank:]]*"
  local marker="'([a-zA-Z_][a-zA-Z0-9_]*)'"
  local output=">${gap}${path}"
  local first="^${gap}cat[[:blank:]]+${output}[[:blank:]]+<<${gap}${marker}${gap}$"
  local last="^${gap}cat[[:blank:]]+<<${gap}${marker}[[:blank:]]+${output}${gap}$"
  local remaining=$((${#cmd} + 1)) lines=0
  while IFS= read -r line; do
    # The byte limit still permits nearly 200,000 empty lines. Bound Bash work
    # before the header regexes, since clients allow a timed-out hook to pass.
    lines=$((lines + 1))
    [ "$lines" -le 4096 ] || deny "too many lines to verify a literal file write in time: split the write into smaller requests"
    remaining=$((remaining - ${#line} - 1))
    if [ -n "$delimiter" ]; then
      if [ "$line" = "$delimiter" ]; then delimiter=""; fi
    elif [[ "$line" =~ $first ]] || [[ "$line" =~ $last ]]; then
      delimiter=${BASH_REMATCH[1]}
      seen=1
    elif [[ ! "$line" =~ ^[[:blank:]]*$ ]]; then
      return 1
    fi
  done < <(printf '%s\n' "$cmd")
  # EOF can also follow an interrupted producer. Account for every byte of cmd
  # plus the newline printed above before accepting a sequence of complete writes.
  [ "$remaining" -eq 0 ] && [ -n "$seen" ] && [ -z "$delimiter" ]
}

# Compute once, only for requests that might qualify. Every other policy still sees
# both original views, including the literal text and destination of each write.
literal_writes=""
if [[ "$cmd" == *"<<"* && "$cmd" == *releases* ]] && literal_file_writes; then
  literal_writes=1
fi

# Read through a process substitution, not a here-document: bash writes a here-document to a
# temporary file, and where it cannot (an unwritable TMPDIR, a sandbox) the loop read nothing and
# every command passed (until session 24b). A jq or pipe failure leaves out the \002 line, and
# the guard denies.
complete=""
while IFS= read -r part; do
  if [ "$part" = $'\002' ]; then
    complete=1
    continue
  fi
  if [ -n "$unattended" ] && { [[ "$part" =~ $release_re ]] || [[ "$part" =~ $gate_re ]]; }; then
    deny "the release verbs are not available in $unattended: PA runs them in a terminal; tell PA, who runs /dev-check-release-readiness, then the command it prints"
  fi
  [[ ! "$part" =~ $mutation_re ]] || deny "PA merges PRs and marks them ready: tell PA the PR number; /dev-status lists it"
  if [[ "$part" =~ $git_re ]]; then
    [[ "$part" != *--no-veri* ]] || deny "--no-verify skips the git hooks: fix what the hook reports; /dev-run-ci-locally runs the same checks"
    shopt -s nocasematch
    if [[ "$part" =~ $config_re ]]; then
      shopt -u nocasematch
      deny "git -c alias.* and -c core.hooksPath are refused: an alias hides the verb, hooksPath skips the hooks; run the plain git command, and fix what a hook reports with /dev-run-ci-locally"
    fi
    shopt -u nocasematch
  fi
  if [[ "$part" =~ $commit_re ]] && [[ "$part" =~ $commit_n_re ]]; then
    deny "git commit -n is --no-verify: it skips the git hooks; fix what the hook reports, /dev-run-ci-locally runs the same checks"
  fi
  if [[ "$part" =~ $push_re ]]; then
    [[ ! "$part" =~ $main_re ]] || deny "pushes to main go through a PR that PA merges: push a branch and open a draft PR as your bot (\`$core/gh-token.sh <bot> -- git push origin HEAD:refs/heads/<branch>\`, then \`gh pr create --draft\` through the same script)"
    [[ ! "$part" =~ $force_re ]] || deny "force pushes, pushes of every branch and remote branch deletions are PA's: say why to PA, who decides; a merged branch is cleaned up with /dev-delete-merged-branches"
  fi
  if [[ "$part" =~ $branch_re ]] && { [[ "$part" =~ $branch_D_re ]] || { [[ "$part" =~ $branch_delete_re ]] && [[ "$part" =~ $branch_force_re ]]; }; }; then
    deny "git branch -D deletes a branch without checking that it was merged: use /dev-delete-merged-branches (checks that GitHub shows the merge); git branch -d stays allowed"
  fi
  [[ ! "$part" =~ $merge_re ]] || deny "PA merges PRs and marks them ready: tell PA the PR number; /dev-status lists it"
  api_release=""
  if [ -z "$literal_writes" ] && [[ "$part" =~ $api_release_re ]]; then api_release=1; fi
  if [[ "$part" =~ $release_create_re ]] || [[ "$part" =~ $release_edit_re ]] || [ -n "$api_release" ]; then
    [[ ! "$part" =~ $undraft_re ]] || deny "releases stay drafts: PA publishes them, with /dev-plugin-release in the workshop or /dev-run-with-owner-token elsewhere"
  fi
  if [[ "$part" =~ $release_create_re ]] && [[ ! "$part" =~ $draft_re ]]; then
    deny "releases stay drafts: create them with --draft; PA publishes them, with /dev-plugin-release in the workshop or /dev-run-with-owner-token elsewhere"
  fi
  if [ -n "$api_release" ] && [[ "$part" =~ $api_write_re ]] && [[ "$part" != *draft=true* ]]; then
    deny "releases stay drafts: a release written through gh api needs draft=true; PA publishes them, with /dev-plugin-release in the workshop or /dev-run-with-owner-token elsewhere"
  fi
done < <(printf '%s' "$cmd" | jq -Rrs "$views" 2>/dev/null)
[ -n "$complete" ] || deny "cannot split the command into simple commands: run \`./dev setup\` (it checks jq), then retry, or split the command"

exit 0
