#!/usr/bin/env bash
# dev: the core dispatcher. Every verb runs under `mise exec`, so tools come from the pinned
# versions in mise.toml and never from the shell. Contract and rules: docs/harness-core.md.
#
# Usage: ./dev setup | check | ci | gate [<sha>] | apply|deploy [args…] | x <command…> | <verb> [args…]
# `gate` and the release verb (`apply` or `deploy`, named in harness.toml) belong to harness/gate.
#
# Layout: this file is <root>/harness/dev (or <root>/.harness/dev in a repository that syncs the
# core); <root>/harness.toml names the profile, the tools to verify and the checks of `ci`.
# Runs on macOS /bin/bash 3.2: no associative arrays, no mapfile.
set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"
cd "$root"

die() {
  echo "dev: $*" >&2
  exit 1
}

# mise by PATH first, then its usual install locations: hooks, scheduled jobs and cloud sessions
# often run with a minimal PATH. Never reads DEV_MISE_BIN or any other variable from the caller.
find_mise() {
  local c
  if c="$(command -v mise 2>/dev/null)" && [ -x "$c" ]; then
    echo "$c"
    return 0
  fi
  for c in /opt/homebrew/bin/mise /usr/local/bin/mise "$HOME/.local/bin/mise"; do
    [ -x "$c" ] && {
      echo "$c"
      return 0
    }
  done
  return 1
}

mise_bin="$(find_mise)" ||
  die "mise not found (PATH, /opt/homebrew/bin, /usr/local/bin, ~/.local/bin). Install mise, then run ./dev setup. A cloud session ships without mise and installs nothing by itself: see docs/harness-core.md, 'Cloud sessions'."

# `setup` is the only verb that installs anything (auto_install is off in mise.toml).
if [ "${1:-}" = "setup" ]; then
  [ "$#" -eq 1 ] || die "usage: ./dev setup"
  "$mise_bin" install --locked
  exec "$self" check
fi

# The release verbs re-run themselves from a clean environment (harness/gate). They are handed
# over before the ordinary re-run below, so nothing from the caller's PATH or mise is used first.
case "${1:-}" in
  apply | deploy) exec "$(dirname "$self")/gate" release "$@" ;;
esac

# Every other verb re-runs itself under mise exec. A caller-set DEV_UNDER_MISE only skips the
# re-run; verify_tools below still refuses any tool that resolves outside mise.
if [ -z "${DEV_UNDER_MISE:-}" ]; then
  export DEV_UNDER_MISE=1
  exec "$mise_bin" exec --locked -- "$self" "$@"
fi

# harness.toml is read by conf.awk, the one parser of that file (see its header). It refuses
# anything outside the restricted subset, so that a typo cannot silently drop a check. The
# [gate] records it also prints belong to harness/gate and are skipped here.
parse_conf() {
  [ -f harness.toml ] || die "harness.toml not found in $root"
  awk -f "$(dirname "$self")/conf.awk" harness.toml
}

parsed="$(parse_conf)"
profile=""
tools=""
checks=""
verbs=""
check_command=""
while IFS="$(printf '\t')" read -r kind a b; do
  case "$kind" in
    conf)
      case "$a" in
        profile) profile="$b" ;;
        tools) tools="$b" ;;
        check) check_command="$b" ;;
      esac
      ;;
    check) checks="$checks$a	$b
" ;;
    verb) verbs="$verbs$a	$b
" ;;
  esac
done <<EOF
$parsed
EOF
[ -n "$profile" ] || die "harness.toml: profile is missing"
[ -n "$tools" ] || die "harness.toml: tools is empty"

# Fails closed: every tool named in harness.toml must resolve into a directory that mise manages.
verify_tools() {
  local dirs t p d found
  dirs="$("$mise_bin" bin-paths)" || die "mise cannot list its tool directories (run ./dev setup)"
  [ -n "$dirs" ] || die "mise has no tools installed (run ./dev setup)"
  for t in $tools; do
    p="$(command -v "$t" 2>/dev/null)" || die "$t not found under mise (run ./dev setup)"
    found=""
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      case "$p" in "$d"/*) found=1 ;; esac
    done <<EOF
$dirs
EOF
    [ -n "$found" ] || die "$t resolved outside mise: $p"
  done
}

# A repository that syncs the core holds it in .harness/ with a CHECKSUMS file (written by
# `./dev sync`). Any changed, missing or extra file there is drift. This detects an accident or a
# hand edit; it is not protection, since an agent could change the file and its checksum together.
verify_core() {
  [ -d .harness ] || return 0
  [ -f .harness/CHECKSUMS ] || die ".harness/CHECKSUMS is missing: re-sync the core (./dev sync in the workshop)"
  local sum listed present
  if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
  (cd .harness && $sum -c --quiet CHECKSUMS >/dev/null 2>&1) ||
    die ".harness differs from its CHECKSUMS (changed or missing file: $(cd .harness && $sum -c CHECKSUMS 2>/dev/null | grep -v ': OK$' | tr '\n' ' '))"
  listed="$(awk '{print $2}' .harness/CHECKSUMS | LC_ALL=C sort)"
  present="$(cd .harness && find . -type f ! -name CHECKSUMS | sed 's|^\./||' | LC_ALL=C sort)"
  [ "$listed" = "$present" ] || die ".harness has files that CHECKSUMS does not list (or lacks listed ones): re-sync the core"
}

# Printed by check and at the start of ci, so that every log carries the resolved versions.
print_tools() {
  local t
  printf '%-12s %s\n' profile "$profile"
  printf '%-12s %s %s\n' mise "$("$mise_bin" --version | head -1)" "$mise_bin"
  for t in $tools; do
    printf '%-12s %s\n' "$t" "$(command -v "$t")"
  done
}

cmd="${1:-}"
case "$cmd" in
  check)
    [ "$#" -eq 1 ] || die "usage: ./dev check"
    verify_tools
    verify_core
    print_tools
    # The repository's own offline check (harness.toml `check`): it must contact nothing.
    if [ -n "$check_command" ]; then
      bash -c "$check_command" </dev/null || die "check failed: $check_command"
    fi
    ;;
  ci)
    [ "$#" -eq 1 ] || die "usage: ./dev ci"
    verify_tools
    verify_core
    print_tools
    if [ -n "$check_command" ]; then
      echo "== check"
      bash -c "$check_command" </dev/null || die "check failed: $check_command"
    fi
    [ -n "$checks" ] || die "harness.toml: no checks"
    while IFS="$(printf '\t')" read -r name command_line; do
      [ -n "$name" ] || continue
      echo "== $name"
      bash -c "$command_line" </dev/null || die "check failed: $name"
    done <<EOF
$checks
EOF
    echo "ci: OK"
    ;;
  gate)
    # Read-only checks of the release gate; no credential is read.
    shift
    verify_tools
    exec "$(dirname "$self")/gate" check "$@"
    ;;
  x)
    shift
    [ "$#" -gt 0 ] || die "usage: ./dev x <command…>"
    verify_tools
    exec "$@"
    ;;
  *)
    # A verb of the repository's own, declared in the [verbs] table of harness.toml.
    while IFS="$(printf '\t')" read -r name command_line; do
      [ -n "$name" ] || continue
      if [ "$name" = "$cmd" ]; then
        shift
        verify_tools
        # Arguments reach the command as positional parameters, never spliced into its text.
        exec bash -c "$command_line \"\$@\"" "dev $cmd" "$@"
      fi
    done <<EOF
$verbs
EOF
    die "usage: ./dev setup | check | ci | gate [<sha>] | apply|deploy [args…] | x <command…> | <verb of harness.toml> [args…]"
    ;;
esac
