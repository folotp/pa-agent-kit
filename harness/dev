#!/usr/bin/env bash
# dev: the core dispatcher. Every verb runs under `mise exec`, so tools come from the pinned
# versions in mise.toml and never from the shell. Contract and rules: docs/harness-core.md.
#
# Usage: ./dev setup | check | ci | gate [<sha>] | apply|deploy [args…] | x <command…> | <verb> [args…]
# `gate` and the release verb (`apply` or `deploy`, named in harness.toml) belong to harness/gate.
#
# Layout: this file is <root>/harness/dev (or <root>/.harness/dev in a repository that syncs the
# core); <root>/harness.toml names the profile, the tools to verify and the checks of `ci`.
# Runs on macOS /bin/bash 3.2: no associative arrays, no mapfile.
set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"
cd "$root"

# Every verb ends with what happened, what is left for PA and the one next step (24i's output
# rule: `done:`, `left for PA:`, `next:`), on success and on refusal, so that nobody has to work
# out what to run next. A `/dev-` command is named where one exists.
#
# die MESSAGE [NEXT [LEFT]]: the refusal line, then the three lines on stderr; nothing changed.
die() {
  echo "dev: $1" >&2
  printf 'done: refused; nothing changed\nleft for PA: %s\nnext: %s\n' "${3:-nothing}" \
    "${2:-fix what the line above names, then run the same ./dev command again}" >&2
  exit 1
}

# ending DONE LEFT NEXT: the three lines of a verb that succeeded, on stdout.
ending() {
  printf 'done: %s\nleft for PA: %s\nnext: %s\n' "$1" "$2" "$3"
}

# mise by PATH first, then its usual install locations: hooks, scheduled jobs and cloud sessions
# often run with a minimal PATH. Never reads DEV_MISE_BIN or any other variable from the caller.
find_mise() {
  local c
  if c="$(command -v mise 2>/dev/null)" && [ -x "$c" ]; then
    echo "$c"
    return 0
  fi
  for c in /opt/homebrew/bin/mise /usr/local/bin/mise "$HOME/.local/bin/mise"; do
    [ -x "$c" ] && {
      echo "$c"
      return 0
    }
  done
  return 1
}

mise_bin="$(find_mise)" ||
  die "mise not found (PATH, /opt/homebrew/bin, /usr/local/bin, ~/.local/bin). A cloud session ships without mise and installs nothing by itself: see $(basename "$(dirname "$self")")/README.md, 'Cloud sessions'." \
    "install mise with its official installer, then ./dev setup" "install mise on this machine, then run ./dev setup in your own terminal"

# The core's git hooks (pre-commit, pre-push), relative to the work tree so that every worktree
# uses its own checkout's copy: harness/githooks in the workshop, .harness/githooks in a consumer.
hooks_path="$(basename "$(dirname "$self")")/githooks"

# `setup` is the only verb that installs anything (auto_install is off in mise.toml): the locked
# tools, and the git hooks (core.hooksPath, written only when it differs: the agent sandbox cannot
# write .git/config, so PA runs setup in a terminal).
if [ "${1:-}" = "setup" ]; then
  [ "$#" -eq 1 ] || die "usage: ./dev setup" "./dev setup"
  "$mise_bin" install --locked
  if [ "$(git config --get core.hooksPath || true)" != "$hooks_path" ]; then
    git config core.hooksPath "$hooks_path" ||
      die "cannot set core.hooksPath to $hooks_path (the agent sandbox cannot write .git/config)" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal"
  fi
  exec "$self" check
fi

# The release verbs re-run themselves from a clean environment (harness/gate). They are handed
# over before the ordinary re-run below, so nothing from the caller's PATH or mise is used first.
case "${1:-}" in
  apply | deploy) exec "$(dirname "$self")/gate" release "$@" ;;
esac

# Every other verb re-runs itself under mise exec. A caller-set DEV_UNDER_MISE only skips the
# re-run; verify_tools below still refuses any tool that resolves outside mise.
if [ -z "${DEV_UNDER_MISE:-}" ]; then
  export DEV_UNDER_MISE=1
  exec "$mise_bin" exec --locked -- "$self" "$@"
fi

# harness.toml is read by conf.awk, the one parser of that file (see its header). It refuses
# anything outside the restricted subset, so that a typo cannot silently drop a check. The
# [gate] records it also prints belong to harness/gate and are skipped here.
parse_conf() {
  [ -f harness.toml ] || die "harness.toml not found in $root"
  awk -f "$(dirname "$self")/conf.awk" harness.toml
}

parsed="$(parse_conf)"
profile=""
tools=""
checks=""
verbs=""
check_command=""
while IFS="$(printf '\t')" read -r kind a b; do
  case "$kind" in
    conf)
      case "$a" in
        profile) profile="$b" ;;
        tools) tools="$b" ;;
        check) check_command="$b" ;;
      esac
      ;;
    check) checks="$checks$a	$b
" ;;
    verb) verbs="$verbs$a	$b
" ;;
  esac
done <<EOF
$parsed
EOF
[ -n "$profile" ] || die "harness.toml: profile is missing"
[ -n "$tools" ] || die "harness.toml: tools is empty"

# Fails closed: every tool named in harness.toml must resolve into a directory that mise manages.
verify_tools() {
  local dirs t p d found
  dirs="$("$mise_bin" bin-paths)" || die "mise cannot list its tool directories" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal"
  [ -n "$dirs" ] || die "mise has no tools installed" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal"
  for t in $tools; do
    p="$(command -v "$t" 2>/dev/null)" || die "$t not found under mise" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal"
    found=""
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      case "$p" in "$d"/*) found=1 ;; esac
    done <<EOF
$dirs
EOF
    [ -n "$found" ] || die "$t resolved outside mise: $p" "./dev setup, in PA's own terminal (mise.toml pins $t)" "run ./dev setup in your own terminal"
  done
}

# A repository that syncs the core holds it in .harness/ with a CHECKSUMS file (written by
# `./dev sync`): one line per file, `<mode> <sha256> <path>`, mode 644 or 755. A changed, missing
# or extra file, a symbolic link, or an executable bit that differs from the recorded mode is
# drift. This detects an accident or a hand edit; it is not protection, since an agent could
# change the file and its checksum together.
verify_core() {
  [ -d .harness ] || return 0
  [ -f .harness/CHECKSUMS ] || die ".harness/CHECKSUMS is missing" "/dev-harness-sync (re-sync the core)"
  local sum mode hash path f bad="" listed present
  if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
  while read -r mode hash path; do
    [[ "$mode" =~ ^(644|755)$ && "$hash" =~ ^[0-9a-f]{64}$ && "$path" =~ ^[A-Za-z0-9._/-]+$ ]] ||
      die ".harness/CHECKSUMS has a malformed line (mode sha256 path expected)" "/dev-harness-sync (re-sync the core)"
    f=".harness/$path"
    if [ ! -f "$f" ] || [ -L "$f" ]; then
      bad="$bad $path (missing)"
      continue
    fi
    [ "$($sum "$f" | awk '{print $1}')" = "$hash" ] || bad="$bad $path (content)"
    if [ "$mode" = 755 ]; then [ -x "$f" ] || bad="$bad $path (mode)"; else [ ! -x "$f" ] || bad="$bad $path (mode)"; fi
  done <.harness/CHECKSUMS
  [ -z "$bad" ] || die ".harness differs from its CHECKSUMS:$bad; never edit .harness/" "undo the edit (git checkout -- .harness), or /dev-harness-sync"
  listed="$(awk '{print $3}' .harness/CHECKSUMS | LC_ALL=C sort)"
  present="$(cd .harness && find . ! -type d ! -name CHECKSUMS | sed 's|^\./||' | LC_ALL=C sort)"
  [ "$listed" = "$present" ] || die ".harness has files that CHECKSUMS does not list (or lacks listed ones)" "remove the extra file, or /dev-harness-sync"
}

# The active git hooks must be the core's (finding K14): a clone that never ran `./dev setup`, or
# whose hooks point elsewhere (an old checkout of another repository), is refused with the fix.
verify_hooks() {
  local active
  active="$(git config --get core.hooksPath || true)"
  [ "$active" = "$hooks_path" ] ||
    die "git hooks are not the core's (core.hooksPath is '${active:-unset}', not '$hooks_path'): run ./dev setup in your own terminal" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal (the agent sandbox cannot write .git/config)"
}

# Printed by check and at the start of ci, so that every log carries the resolved versions.
# Each tool's version is the one mise resolved it to (`mise which --version`, report 2.4); no tool
# is run to ask it.
print_tools() {
  local t version
  printf '%-12s %s\n' profile "$profile"
  printf '%-12s %s %s\n' mise "$("$mise_bin" --version | head -1)" "$mise_bin"
  for t in $tools; do
    version="$("$mise_bin" which "$t" --version 2>/dev/null)" || die "mise cannot tell the version of $t" "./dev setup, in PA's own terminal" "run ./dev setup in your own terminal"
    printf '%-12s %-10s %s\n' "$t" "$version" "$(command -v "$t")"
  done
}

# A check command runs in its own bash with pipefail, so a failure early in a pipeline is not
# hidden by a successful last command (Codex C11).
run_check() {
  bash -o pipefail -c "$1" </dev/null
}

# The core's own checks of the repository (24g: D1 pins, D2 Dependabot, F5 guard bindings), offline text checks next to this file.
# Each prints one line per finding and exits non-zero; every check runs, so one pass shows all of
# them, then any finding fails `check` and `ci`.
core_checks() {
  local here failed=""
  here="$(dirname "$self")"
  if [ -d .github ]; then
    "$here/check-pins" || failed="$failed pins"
    "$here/check-dependabot" || failed="$failed dependabot"
  fi
  "$here/check-bindings" || failed="$failed bindings"
  [ -z "$failed" ] || die "core checks failed:$failed (each line above names the file and the fix)" "fix each line above, then ./dev check (.harness/README.md, 'Core checks')"
  printf '%-12s %s\n' core-checks ok
}

cmd="${1:-}"
case "$cmd" in
  check)
    [ "$#" -eq 1 ] || die "usage: ./dev check" "./dev check"
    verify_tools
    verify_core
    verify_hooks
    print_tools
    printf '%-12s %s\n' hooks "$hooks_path"
    core_checks
    # The repository's own offline check (harness.toml `check`): it must contact nothing.
    if [ -n "$check_command" ]; then
      run_check "$check_command" || die "check failed: $check_command" "fix what it reports, then /dev-run-ci-locally"
    fi
    ending "./dev check passed" "nothing" "commit; ./dev ci before pushing (/dev-run-ci-locally)"
    ;;
  ci)
    [ "$#" -eq 1 ] || die "usage: ./dev ci" "./dev ci"
    verify_tools
    verify_core
    print_tools
    core_checks
    if [ -n "$check_command" ]; then
      echo "== check"
      run_check "$check_command" || die "check failed: $check_command" "fix what it reports, then /dev-run-ci-locally"
    fi
    [ -n "$checks" ] || die "harness.toml: no checks"
    while IFS="$(printf '\t')" read -r name command_line; do
      [ -n "$name" ] || continue
      echo "== $name"
      run_check "$command_line" || die "check failed: $name" "fix what it reports, then /dev-run-ci-locally"
    done <<EOF
$checks
EOF
    echo "ci: OK"
    ending "./dev ci passed" "nothing" "push the branch as your bot: $(basename "$(dirname "$self")")/gh-token.sh <bot> -- git push origin HEAD:refs/heads/<branch>"
    ;;
  gate)
    # Read-only checks of the release gate; no credential is read.
    shift
    verify_tools
    exec "$(dirname "$self")/gate" check "$@"
    ;;
  x)
    shift
    [ "$#" -gt 0 ] || die "usage: ./dev x <command…>" "./dev x <command…>"
    verify_tools
    exec "$@"
    ;;
  *)
    # A verb of the repository's own, declared in the [verbs] table of harness.toml.
    while IFS="$(printf '\t')" read -r name command_line; do
      [ -n "$name" ] || continue
      if [ "$name" = "$cmd" ]; then
        shift
        verify_tools
        # Arguments reach the command as positional parameters, never spliced into its text.
        exec bash -c "$command_line \"\$@\"" "dev $cmd" "$@"
      fi
    done <<EOF
$verbs
EOF
    die "usage: ./dev setup | check | ci | gate [<sha>] | apply|deploy [args…] | x <command…> | <verb of harness.toml> [args…]" "/dev-help (every command, with what it does)"
    ;;
esac
